@model List<Person>
@{
    ViewData["Title"] = "Alle Kontakte anzeigen";
}

<h1 class="mt-4 mb-2">Kontakte</h1>

<a href="@Url.Action("Add")" class="btn btn-sm btn-secondary mb-4"><i class="fa-solid fa-plus"></i> Neuer Kontakt</a>

<table class="table table-striped table-hover">
    <thead>
        <tr>
            <th>Id</th>
            <th>Vorname</th>
            <th>Nachname</th>
            <th>Alter</th>
            <th>Optionen</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var person in Model)
        {
            <tr>
                <td>@person.Id</td>
                <td>@person.Firstname</td>
                <td>@person.Lastname</td>
                <td>@person.Age</td>
                <td>
                    <a class="btn btn-sm btn-secondary" href="@Url.Action("Edit", new { id = person.Id })"><i class="fa-solid fa-pen"></i></a>
                    <a class="btn btn-sm btn-secondary" href="@Url.Action("Delete", new { id = person.Id })"><i class="fa-solid fa-trash"></i></a>
                </td>
            </tr>
        }
    </tbody>
</table>
